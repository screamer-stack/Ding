




<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Retro Games Hub</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>Retro Games Hub</h1>
    <nav>
      <a href="#">Home</a>
      <a href="#">Top Games</a>
      <a href="#">New Releases</a>
      <a href="#">About</a>
    </nav>
  </header>

  <section class="featured">
    <h2>Featured Game: Retro Bowl</h2>
    <div class="game-container">
      <iframe 
        src="https://retro-bowl.io/" 
        title="Retro Bowl"
        frameborder="0"
        allowfullscreen>
      </iframe>
    </div>
  </section>

  <section class="game-list">
    <h2>More Games</h2>
    <div class="games">
      <div class="game">
        <img src="https://placehold.co/200x120" alt="Game 1">
        <h3>Space Invaders</h3>
      </div>
      <div class="game">
        <img src="https://placehold.co/200x120" alt="Game 2">
        <h3>Pac-Man</h3>
      </div>
      <div class="game">
        <img src="https://placehold.co/200x120" alt="Game 3">
        <h3>Tetris</h3>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2025 Retro Games Hub | Built for fun 🎮</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
